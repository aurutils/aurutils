#!/bin/bash -
set -o errexit
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Simulate makepkg --syncdeps / --rmdeps as root with pacman
argv0=makepkg-asroot

# default options
mode=build checkdepends=1 nodeps=0 syncdeps=0 rmdeps=0 install=0 install_asdeps=0

# default arguments
makepkg_args=() makepkg_conf_args=() pacman_args=() pacman_install_args=()

usage() {
    printf >&2 'usage: %s [-U user] [-s] [-r] [makepkg options]\n' "$argv0"
    exit 1
}

# Drop permissions for commands as needed (#907)
as_user() {
    #global build_user
    local USER HOME SHELL gid

    # runuser --pty messes up the terminal with AUR_DEBUG set, use setpriv(1)
    # and replicate the runuser(1) behavior for setting the environment
    { IFS= read -r USER
      IFS= read -r gid
      IFS= read -r HOME
      IFS= read -r SHELL
    } < <(getent passwd "$build_user" | awk -F: '{printf("%s\n%s\n%s\n%s\n", $1, $4, $6, $7); }')
    wait "$!"

    # --no-new-privs: avoid `sudo` calls in build scripts from escalating privileges
    setpriv --no-new-privs --reuid "$build_user" --regid "$gid" --init-groups \
        env USER="$USER" HOME="$HOME" LOGNAME="$USER" SHELL="$SHELL" "$@"
}

# Retrieve dependencies as regular user (sources PKGBUILD). As makepkg, only
# global dependencies are used (pkgbase section), not those of split packages.
# Assumes the build user has access to the PKGBUILD directory, see:
# http://allanmcrae.com/2015/01/replacing-makepkg-asroot/
get_depends_as_user() {
    local srcinfo
    srcinfo=$(as_user makepkg "${makepkg_conf_args[@]}" --printsrcinfo) || return

    # XXX: uses the host architecture instead of CARCH in makepkg.conf
    awk -v check="$checkdepends" -v arch="$(uname -m)" '
        $1 == "pkgname" { exit }
        $1 == "depends"     || $1 == "depends_" arch     { print $3 }
        $1 == "makedepends" || $1 == "makedepends_" arch { print $3 }
        check && ($1 == "checkdepends" || $1 == "checkdepends_" arch) { print $3 }
    ' <<< "$srcinfo"
}

# Print dependencies which are not installed
get_missing_depends() {
    local ret=0

    if (( $# )); then
        # exit status 127: at least one dependency is missing
        pacman -T -- "$@" || ret=$?
        (( ret == 0 || ret == 127 ))
    fi
}

# As makepkg: compare the installed packages before and after the transaction,
# so that it can be undone later.
install_depends() {
    #global pacman_args pacman_install_args installed_pkglist removed_pkglist
    local original_pkglist current_pkglist

    if (( $# )); then
        mapfile -t original_pkglist < <(pacman -Qq)
        wait "$!"

        pacman -S --asdeps "${pacman_args[@]}" "${pacman_install_args[@]}" -- "$@"

        mapfile -t current_pkglist < <(pacman -Qq)
        wait "$!"

        mapfile -t installed_pkglist < <(
            grep -xvFf <(printf '%s\n' "${original_pkglist[@]}") <(printf '%s\n' "${current_pkglist[@]}"))
        mapfile -t removed_pkglist < <(
            grep -xvFf <(printf '%s\n' "${current_pkglist[@]}") <(printf '%s\n' "${original_pkglist[@]}"))
    fi
}

remove_depends() {
    #global pacman_args installed_pkglist removed_pkglist
    if (( ! ${#installed_pkglist[@]} )); then
        return
    fi

    # Packages were removed during dependency installation (e.g. conflicts).
    # Removing all installed packages is risky in this case.
    if (( ${#removed_pkglist[@]} )); then
        warning '%s: failed to remove installed dependencies' "$argv0"
    else
        # the package was built at this point, do not fail on removal
        pacman -Rnu "${pacman_args[@]}" -- "${installed_pkglist[@]}" ||
            warning '%s: failed to remove installed dependencies' "$argv0"
    fi
    installed_pkglist=()
}

source /usr/share/makepkg/util/parseopts.sh
source /usr/share/makepkg/util/message.sh

# option parsing
opt_short='rsU:' # special options
opt_short+='AcdefghiLmop:RSVC' # options passed on to makepkg
opt_long=('rmdeps' 'nocheck' 'check' 'user:' 'syncdeps' 'noconfirm')
opt_long+=(
    'ignorearch' 'clean' 'config:' 'nodeps' 'noextract' 'verifysource'
    'force' 'geninteg' 'skipinteg' 'skipchecksums' 'skippgpcheck' 'help'
    'holdver' 'install' 'log' 'nocolor' 'nobuild' 'source' 'version'
    'cleanbuild' 'allsource' 'noarchive' 'noprepare' 'sign' 'nosign'
    'key:' 'needed' 'asdeps' 'noprogressbar' 'packagelist' 'printsrcinfo'
    'repackage'
)

if ! parseopts "$opt_short" "${opt_long[@]}" -- "$@"; then
    usage
fi
set -- "${OPTRET[@]}"

unset build_user
while true; do
    case "$1" in
        # special options
        -U|--user)
            shift; build_user=$1 ;;
        -s|--syncdeps)
            syncdeps=1 ;;
        -r|--rmdeps)
            rmdeps=1 ;;
        -d|--nodeps)
            nodeps=1; makepkg_args+=("$1") ;;
        --nocheck)
            checkdepends=0; makepkg_args+=("$1") ;;
        # pacman options
        -i|--install)
            install=1 ;;
        --asdeps)
            install_asdeps=1 ;;
        --noconfirm|--noprogressbar)
            pacman_args+=("$1") ;;
        --needed)
            pacman_install_args+=("$1") ;;
        # makepkg modes
        -o|--nobuild)
            mode=nobuild; makepkg_args+=("$1") ;;
        -g|--geninteg|-h|--help|-S|--source|-V|--version|--allsource|--packagelist|--printsrcinfo)
            mode=other; makepkg_args+=("$1") ;;
        # other makepkg arguments
        -A|--ignorearch|-c|--clean|-C|--cleanbuild|-e|--noextract|-f|--force|-L|--log|-m|--nocolor)
            makepkg_args+=("$1") ;;
        -R|--repackage|--check|--verifysource|--skipinteg|--skipchecksums|--skippgpcheck)
            makepkg_args+=("$1") ;;
        --holdver|--noarchive|--noprepare|--sign|--nosign)
            # XXX: signing might have to be handled manually (necessary environment
            # variables not available in the root environment)
            makepkg_args+=("$1") ;;
        --config)
            shift; makepkg_args+=(--config "$1")
            makepkg_conf_args+=(--config "$1") ;;
        -p|--key)
            makepkg_args+=("$1" "$2"); shift ;;
        --) shift; break ;;
    esac
    shift
done

if [[ ! -v NO_COLOR ]] && [[ ! -v AUR_DEBUG ]]; then
    [[ -t 2 ]] && colorize
fi

if (( EUID != 0 )); then
    error '%s: must be run as root' "$argv0"
    exit 1
fi

# check that an unprivileged user is specified
build_user=${build_user:-$SUDO_USER}

if [[ -z $build_user ]] || ! build_uid=$(id -u "$build_user") || (( build_uid == 0 )); then
    error '%s: unprivileged user required' "$argv0"
    exit 2
fi

# remove dependencies on success, error or interrupt (makepkg --rmdeps)
installed_pkglist=() removed_pkglist=()
if (( rmdeps )); then
    trap 'remove_depends' EXIT
fi

case $mode in
    build|nobuild) # syncdeps/rmdeps also apply to --nobuild (download agents e.g.)
        if (( syncdeps )) && (( ! nodeps )); then
            mapfile -t depends < <(get_depends_as_user)
            wait "$!"

            # retrieve dependencies which are missing on the host
            mapfile -t missing < <(get_missing_depends "${depends[@]}")
            wait "$!"

            install_depends "${missing[@]}"
        fi

        # Now we can build the package
        as_user makepkg "${makepkg_args[@]}"

        if (( install )) && [[ $mode == "build" ]]; then
            mapfile -t pkglist < <(as_user makepkg "${makepkg_conf_args[@]}" --packagelist)
            wait "$!"

            # makepkg --packagelist also prints packages which were not
            # created, such as debug packages
            pkgs=()
            for p in "${pkglist[@]}"; do
                [[ -f $p ]] && pkgs+=("$p")
            done

            if (( install_asdeps )); then
                pacman -U --asdeps "${pacman_args[@]}" "${pacman_install_args[@]}" -- "${pkgs[@]}"
            else
                pacman -U "${pacman_args[@]}" "${pacman_install_args[@]}" -- "${pkgs[@]}"
            fi
        fi
        ;;
    other)
        as_user makepkg "${makepkg_args[@]}"
        ;;
esac

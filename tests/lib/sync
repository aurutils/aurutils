#!/bin/bash
# Check that aur-sync presents build files (aur-view) before it reads them
# (aur-graph), and does not read them when the inspection is aborted.
#
# Programs that require the AUR, a local repository or a terminal are replaced
# with stubs. aur-format, aur-sync--filter and aur-graph are run as is.
set -e
trap 'printf >&2 "%s: failed at line %s\n" "$0" "$LINENO"' ERR

tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
mkdir "$tmp"/bin "$tmp"/aurdest "$tmp"/config

exec_path=$(aur --exec-path)
SYNC_TEST_GRAPH=$(PATH=$exec_path:$PATH type -P aur-graph)

stub() {
    cat >"$tmp/bin/$1"
    chmod +x "$tmp/bin/$1"
}

# aur build --status
stub aur-build <<'STUB'
#!/bin/bash
printf 'repo:test\nroot:%s\npath:%s/test.db\nmakepkg:-\npacman:-\n' "$SYNC_TEST" "$SYNC_TEST"
STUB

# no packages in the local repository
stub aur-repo-parse <<'STUB'
#!/bin/bash
STUB

# AUR metadata for a single target
stub aur-depends <<'STUB'
#!/bin/bash
printf '%s\n' '{"Name":"foo","PackageBase":"foo","Version":"1-1","RequiredBy":{"foo":"Self"}}'
STUB

# build files, in the current directory (AURDEST)
stub aur-fetch <<'STUB'
#!/bin/bash
mkdir -p foo
printf 'pkgbase = foo\n\tpkgver = 1\n\tpkgrel = 1\n\tarch = any\n\npkgname = foo\n' >foo/.SRCINFO
STUB

stub aur-view <<'STUB'
#!/bin/bash
echo view >>"$SYNC_TEST"/order
[[ ! -e $SYNC_TEST/abort ]]
STUB

stub aur-graph <<'STUB'
#!/bin/bash
echo graph >>"$SYNC_TEST"/order
exec "$SYNC_TEST_GRAPH" "$@"
STUB

export SYNC_TEST=$tmp SYNC_TEST_GRAPH
export AUR_EXEC_PATH=$tmp/bin:$exec_path AURDEST=$tmp/aurdest XDG_CONFIG_HOME=$tmp/config

sync() {
    aur sync --no-ver --no-provides --no-build foo 2>/dev/null
}

# aur-view is run before aur-graph, and the queue is printed
out=$(sync)
[[ $out == "$tmp/aurdest/foo" ]]
[[ $(<"$tmp"/order) == $'view\ngraph' ]]

# aur-graph is not run if aur-view fails
rm "$tmp"/order
touch "$tmp"/abort

if sync; then
    false
fi
[[ $(<"$tmp"/order) == view ]]

#!/bin/bash
# Check that aur-sync--ninja quotes the source directory and the build
# command, for ninja and for the shell which runs the command, and that it
# only accepts package names on standard input.
#
# build.ninja is generated for bar and foo, where foo depends on bar, and is
# built with ninja. The build command writes its working directory and its
# arguments to a file.
cd "$(dirname "${BASH_SOURCE[0]}")" || exit

fail() {
    printf >&2 '%s: %s\n' "${BASH_SOURCE[0]}" "$1"
    [[ ! -s $tmp/stderr ]] || cat >&2 "$tmp"/stderr
    exit 1
}

if ! type -P ninja >/dev/null; then
    printf >&2 '%s: ninja is not installed, test skipped\n' "${BASH_SOURCE[0]}"
    exit 0
fi

tmp=$(mktemp -d) || exit
trap 'rm -rf -- "$tmp"' EXIT

# ninja_build SRCDIR ARG...: the build writes to $tmp/log, and to the stamp
# files in $tmp/ninja.
ninja_build() {
    local srcdir=$1
    shift

    rm -rf -- "$tmp"/ninja "$tmp"/log
    mkdir -p -- "$tmp"/ninja "$srcdir"/foo "$srcdir"/bar || exit
    touch -- "$srcdir"/foo/PKGBUILD "$srcdir"/bar/PKGBUILD

    # shellcheck disable=SC2016
    printf '%s\n' 'bar bar' 'foo bar' 'foo foo' |
        aur sync--ninja "$srcdir" -- sh -c 'printf "%s\n" "$PWD" "$@" >>"$0"' \
            "$tmp"/log "$@" >"$tmp"/ninja/build.ninja 2>"$tmp"/stderr ||
        fail 'aur-sync--ninja failed'

    ninja -C "$tmp"/ninja >"$tmp"/stderr 2>&1 ||
        fail 'ninja failed'
}

# check SRCDIR ARG...: every build ran in its directory with ARG..., in
# dependency order, and no other command was run.
check() {
    local srcdir=$1
    shift
    ninja_build "$srcdir" "$@"

    diff -u <(printf '%s\n' "$srcdir"/bar "$@" "$srcdir"/foo "$@") "$tmp"/log >"$tmp"/stderr ||
        fail "unexpected build in ${srcdir@Q} with arguments ${*@Q}"
    [[ -f $tmp/ninja/bar.stamp && -f $tmp/ninja/foo.stamp ]] ||
        fail 'no stamp files'
    [[ ! $(find "$tmp" -name 'INJECTED*' -print -quit) ]] ||
        fail "command was run from ${srcdir@Q} or ${*@Q}"
}

# shellcheck disable=SC2016
{
    check "$tmp/src"
    check "$tmp/src" --flag 'a  b' '$HOME' '$$' '$(touch INJECTED1)' '`touch INJECTED2`' \
        "it's" '"' ';touch INJECTED3' '$ a' 'a:b'

    # ninja escapes: $, space and :
    check "$tmp/a b"
    check "$tmp/a:b"
    check "$tmp/a\$b \$HOME \$ c"

    # shell metacharacters
    check "$tmp/x;touch INJECTED4;"
    check "$tmp/x\$(touch INJECTED5)\`touch INJECTED6\`"
    check "$tmp/it's \"x\" && touch INJECTED7"
    check "$tmp/x>z*?[a]&y"
}

# Package names are written to build.ninja as is.
names() {
    printf '%s\n' "$1" | aur sync--ninja "$tmp/src" -- true 2>"$tmp"/stderr
}

for name in foo Foo foo-bar foo.bar foo_bar foo+bar foo@bar @foo _foo +foo 0foo; do
    names "$name $name" >/dev/null ||
        fail "package name was not accepted: $name"
done

# shellcheck disable=SC2016
for name in -foo .foo ../foo foo/bar 'foo;touch${IFS}INJECTED8' '$(id)' '`id`' \
            'foo|bar' 'foo\bar' 'foo$bar' 'foo:bar' "foo'bar" 'foo*' fooé; do
    for line in "$name $name" "foo $name" "$name foo"; do
        if names "$line" >"$tmp"/build.ninja; then
            fail "invalid package name was accepted: ${line@Q}"
        fi
        grep -q 'invalid package name' "$tmp"/stderr ||
            fail "no diagnostic for ${line@Q}"
    done
done

# a line without dependency
if names foo >/dev/null; then
    fail 'line with a single name was accepted'
fi

# Every invalid name is printed once, and build.ninja is left empty.
# shellcheck disable=SC2016
if names $'bar bar\nfoo -a\nfoo $(id)\n../b foo\nfoo -a' >"$tmp"/build.ninja; then
    fail 'invalid package names were accepted'
fi
diff -u "$tmp"/stderr - >"$tmp"/diff <<'EOF' || { cat >&2 "$tmp"/diff; fail 'unexpected diagnostics'; }
sync--ninja: invalid package name: -a
sync--ninja: invalid package name: \$\(id\)
sync--ninja: invalid package name: ../b
EOF
[[ ! -s $tmp/build.ninja ]] ||
    fail 'build.ninja was written for invalid package names'

# In UTF-8 locales other than C.UTF-8, a-z includes letters such as é.
locale=$(locale -a | grep -im1 '^[a-z][a-z]_[A-Z][A-Z]\.utf-\?8$')

if [[ $locale ]]; then
    if LC_ALL=$locale names 'fooé fooé' >/dev/null; then
        fail "invalid package name was accepted in $locale: fooé"
    fi
    # the directory is quoted as is, with no escapes for other characters
    LC_ALL=$locale check "$tmp/é ü"
fi

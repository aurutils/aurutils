#!/bin/bash
# shellcheck disable=SC2086
# build--sync - helper for upgrading local repository
set -o errexit
[[ -v AUR_DEBUG ]] && set -o xtrace
argv0=build--sync
PS4='+(${BASH_SOURCE}:${LINENO}): ${FUNCNAME[0]:+${FUNCNAME[0]}(): }'

# default options
conf_args=() sync_args=() db_names=() pacman_conf='' confirm=1

args_csv() {
    # shellcheck disable=SC2155
    local str=$(printf '%s,' "$@")
    printf '%s' "${str%,}"
}

get_local_config() {
    #global conf_args
    local repo

    printf '[options]\n'
    pacconf "${conf_args[@]}" --options --raw

    for repo in "$@"; do
        printf '[%s]\n' "$repo"
        pacconf "${conf_args[@]}" --repo="$repo" --raw
    done
}

# https://lists.archlinux.org/pipermail/pacman-dev/2013-August/017743.html
wait_lock() {
    local lockfile=$1 

    # Adapted from `run_pacman()` in `makepkg`
    while [[ -f $lockfile ]]; do
        local timer=0
        printf >&2 '%s: pacman is currently in use, please wait...\n' "$argv0"

        while [[ -f $lockfile ]] && (( timer < 10 )); do
            (( ++timer ))
            sleep 3
        done
    done
    command -- "${@:2}"
}

# option parsing
opt_short='d:nu'
opt_long=('database:' 'config:' 'noconfirm' 'sysupgrade')
orig_argv=("$@")

usage() {
    printf >&2 'usage: %s [-nu] [--config path] [-d database]...\n' "$argv0"
    exit 1
}

if opts=$(getopt -o "$opt_short" -l "$(args_csv "${opt_long[@]}")" -n "$argv0" -- "$@"); then
    eval set -- "$opts"
else
    usage
fi

while true; do
    case "$1" in
        -d|--database)
            shift; db_names+=("$1") ;;
        --config)
            shift; pacman_conf=$1 ;;
        -n|--noconfirm)
            confirm=0 ;;
        -u|--sysupgrade)
            sync_args+=(--sysupgrade) ;;
        --) shift; break ;;
    esac
    shift
done

# pactrans takes end-of-file as confirmation. Without a terminal, the
# transaction would proceed without --noconfirm.
if [[ ! -t 0 ]] && (( confirm )); then
    printf >&2 '%s: no terminal available, use --noconfirm to proceed\n' "$argv0"
    exit 1
fi

if (( EUID != 0 )); then
    exec ${AUR_PACMAN_AUTH:-sudo} "${BASH_SOURCE[0]}" "${orig_argv[@]}"
fi

# pactrans reads targets from stdin if it is not a terminal (pactrans(1))
[[ -t 0 ]] || exec </dev/null

# Restricted configuration for pactrans. Use a temporary file instead of
# process substitution, so that errors are caught before the transaction.
tmp=$(mktemp) || exit
trap 'rm -f "$tmp"' EXIT

if [[ $pacman_conf ]]; then
    if [[ ! -f $pacman_conf ]]; then
        printf >&2 '%s: %s: no such file\n' "$argv0" "$pacman_conf"
        exit 2
    fi
    conf_args+=(--config "$pacman_conf")
fi

if (( ! confirm )); then
    sync_args+=(--noconfirm)
fi

lockfile=$(paclock "${conf_args[@]}" --print)

wait_lock "$lockfile" pacsync "${conf_args[@]}" -- "${db_names[@]}"
wait_lock "$lockfile" pacsync "${conf_args[@]}" --dbext=.files -- "${db_names[@]}"

if [[ ${db_names[*]} ]]; then
    # Do not replace packages installed from other repositories
    sync_args+=(--resolve-replacements=none)

    # Restrain configuration to specified repositories
    get_local_config "${db_names[@]}" > "$tmp"

    wait_lock "$lockfile" pactrans --install "${sync_args[@]}" --config "$tmp"
else
    wait_lock "$lockfile" pactrans --install "${sync_args[@]}" "${conf_args[@]}"
fi


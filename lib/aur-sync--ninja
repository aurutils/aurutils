#!/bin/bash
# aur-sync--ninja - generate ninja.build files for aur-sync

if [[ -v AUR_DEBUG ]]; then
    set -o xtrace
    PS4='+(${BASH_SOURCE}:${LINENO}): ${FUNCNAME[0]:+${FUNCNAME[0]}(): }'
fi

# Ranges such as a-z include other letters outside of the C locale. The
# locale is only set for the match: quoted expansion (@Q) depends on it.
valid_name() {
    local LC_ALL=C
    [[ $1 =~ ^[a-zA-Z0-9@_+][a-zA-Z0-9@._+-]*$ ]]
}

# parent of PKGBUILD directories (relative or absolute)
srcdir=.
if [[ -d $1 ]]; then
    srcdir=$1
    # https://github.com/ninja-build/ninja/blob/master/misc/ninja_syntax.py
    srcdir=${srcdir//\$/\$\$} srcdir=${srcdir// /\$ } srcdir=${srcdir//:/\$:}
fi
shift

# The command is run by the shell: use quoted expansion (@Q), and escape $
# for ninja. Heredocs are expanded like double-quoted strings.
command=${*@Q} command=${command//\$/\$\$}

# Names are written to build.ninja as is, and are part of the build
# directory. The input is not necessarily from aur-sync: only accept
# package names. All input is read first, so that every invalid name is
# printed (once), and nothing is written to build.ninja in this case.
pkgbases=() depends=()
declare -A invalid

while read -r pkgbase depends_pkgbase _; do
    for name in "$pkgbase" "$depends_pkgbase"; do
        if ! valid_name "$name" && [[ ! -v invalid["x$name"] ]]; then
            printf >&2 'sync--ninja: invalid package name: %q\n' "$name"
            invalid["x$name"]=1  # x: an empty key is not allowed
        fi
    done
    pkgbases+=("$pkgbase") depends+=("$depends_pkgbase")
done

if (( ${#invalid[@]} )); then
    exit 2
fi

# shellcheck disable=SC2154
cat <<EOF
rule aurbuild
    command = env -C \${directory} $command && date --rfc-3339=ns > \${out}
    pool = console
EOF

# input is assumed to be ordered by pkgbase (e.g. aur-depends --graph)
current_package=
for i in "${!pkgbases[@]}"; do
    pkgbase=${pkgbases[i]} depends_pkgbase=${depends[i]}

    if [[ $pkgbase != "$current_package" ]] && [[ $current_package ]]; then
        directory=$srcdir/$current_package
        printf '\n%-4sdirectory = %s\n' ' ' "${directory@Q}"
    fi
    if [[ $pkgbase != "$current_package" ]] || [[ ! $current_package ]]; then
        # TODO: take input file (monitored for changes by ninja) as argument
        printf 'build %s.stamp: aurbuild %s/PKGBUILD | ' "$pkgbase" "$srcdir/$pkgbase"
    fi
    current_package=$pkgbase

    # don't add dependency to self
    if [[ $pkgbase != "$depends_pkgbase" ]]; then
        printf '%s.stamp ' "$depends_pkgbase"
    fi
done
directory=$srcdir/$current_package
printf '\n%-4sdirectory = %s\n' ' ' "${directory@Q}"

